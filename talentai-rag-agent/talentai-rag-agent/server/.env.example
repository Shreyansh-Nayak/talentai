# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/talentai

# Auth
JWT_SECRET=replace_with_a_long_random_string

# AI (Groq - used by both /api/ai/* endpoints and the /api/agent Q&A agent)
GROQ_API_KEY=your_groq_api_key

# RAG - local embeddings (Xenova/transformers)
# Optional: where the ~90MB MiniLM model is cached after first download.
# Defaults to ./.cache if unset. No API key needed - embeddings run
# entirely on your machine/server, not via a paid API.
EMBEDDING_CACHE_DIR=./.cache

# Cloudinary (resume uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (password reset, notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
